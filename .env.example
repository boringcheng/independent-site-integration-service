# 本地开发环境变量（复制为 .env 后按需修改；.env 不要提交到 Git）

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=shopify_shopline
MYSQL_USER=app
MYSQL_PASSWORD=app_pass
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=redis_pass
REDIS_PORT=6379

# --- 应用连接串（本地开发） ---
DATABASE_URL=mysql+pymysql://app:app_pass@127.0.0.1:3306/shopify_shopline?charset=utf8mb4
REDIS_URL=redis://:redis_pass@127.0.0.1:6379/0

# --- 以下为业务侧占位，接入时再补 ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPLINE_APP_KEY=
# SHOPLINE_APP_SECRET=
